  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch WALStreamer Package",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/walstreamer",
      "args": ["-config", "${workspaceFolder}/config.yaml"]
    },
    {
      "name": "Launch GCloud Package",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/gcloud"
    }
  ]
}
